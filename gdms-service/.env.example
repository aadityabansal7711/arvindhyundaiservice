# Shared secret the main app must send as `Authorization: Bearer <token>`.
GDMS_SERVICE_TOKEN="<random-base64-string>"

PORT=8080

# --- Bright Data India ISP proxy (network-egress fix for Railway's IP being
# blocked by GDMS — see gdms-probe's /proxy-test results). Optional: if unset,
# gdms-service connects to GDMS directly, which is fine for local dev on a
# network that already reaches GDMS (this only matters on Railway).
# If ANY of the three below is set, ALL three must be — a partially-set proxy
# config is refused rather than silently falling back to direct egress.
GDMS_PROXY_SERVER="http://brd.superproxy.io:44445"
# The BASE Bright Data zone username only — no -country-in/-session-<id>
# suffix. Those are appended per-session automatically (see proxy-config.ts).
GDMS_PROXY_USERNAME="<base Bright Data username, e.g. brd-customer-XXX-zone-YYY>"
GDMS_PROXY_PASSWORD="<secret>"

# When "true", runs a dev-only egress-consistency check (page navigation vs
# context.request, both against a public IP-echo service) before sending the
# OTP, verifying the OTP, and fetching ROs — logs a peer-hash comparison,
# throws if they don't match. Leave unset/false in normal operation; it adds
# extra round-trips and a dependency on a third-party IP-echo endpoint that
# real user sessions shouldn't pay for.
GDMS_PROXY_DEBUG="false"
