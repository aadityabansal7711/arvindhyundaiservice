# Shared secret the caller must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -base64 32
PROBE_TOKEN="<random-base64-string>"

# Optional — a human-readable label for this run's "environment" field
# (e.g. "railway-singapore", "local-mac", "vps-mumbai"). Defaults to the
# machine's hostname if unset.
PROBE_ENV_LABEL=""

PORT=8080
