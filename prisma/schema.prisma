generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  roles       RolePermission[]
  userGrants  UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([roleId])
}

// Per-user permission grant, additive on top of whatever the user's role
// already grants — e.g. giving one specific Manager GDMS access without
// opening it up to every user who shares that role.
model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
  @@index([userId])
}

model Branch {
  id            String        @id @default(cuid())
  name          String
  city          String
  users         User[]
  userBranches  UserBranch[]
  dropdownOptions DropdownOption[]
  gdmsCredentials GdmsCredential[]
}

model User {
  id               String    @id @default(cuid())
  name             String
  phone            String?
  email            String    @unique
  passwordHash     String
  supabaseAuthId   String?   @unique // links to Supabase auth.users.id for Auth sync
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  branches         UserBranch[]
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  gdmsCredentials  GdmsCredential[]
  permissions      UserPermission[]

  @@index([active])
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model DropdownOption {
  id         String   @id @default(cuid())
  groupKey   String   // e.g. "insurance_company", "ro_status"
  label      String   // display text in dropdown
  value      String?  // stored value (if empty, use label)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  sortOrder  Int      @default(0)
  department String?  // service_advisor only: "bodyshop" | "workshop" | "both"

  @@index([groupKey])
  @@index([branchId])
  @@index([groupKey, branchId])
}

// Per-user, per-branch GDMS (Hyundai NDMS dealer portal) login used by the
// "Fetch from GDMS" automation — each person stores their own personal GDMS
// account for each branch they're assigned to. `encryptedPassword` is
// AES-256-GCM ciphertext (see src/lib/gdms/crypto.ts) — the plaintext
// password never touches the database.
model GdmsCredential {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  gdmsUserId        String
  encryptedPassword String
  updatedAt         DateTime @updatedAt

  @@unique([userId, branchId])
  @@index([branchId])
}
