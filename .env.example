# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# NextAuth — required for sessions in dev and production
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<random-base64-string>"

# Supabase (optional, for photo uploads)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Encrypts stored GDMS branch passwords ("Fetch from GDMS" feature) at rest.
# Generate with: openssl rand -base64 32
GDMS_CREDENTIALS_ENC_KEY="<32-byte-base64-key>"
